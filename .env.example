# maavaDao Web Environment Variables

# ── Backend API URL ──
# For local development, use: http://localhost:3000
# For production, use your deployed API URL
NEXT_PUBLIC_API_URL=http://localhost:3000

# Auth microservice base URL (baked into the build by Next.js - MUST be set at docker build time)
# For local dev: http://localhost:8080
# For production: https://auth.maavadao.com
NEXT_PUBLIC_AUTH_URL=http://localhost:8080

# Domain of this site (e.g. maavadao.com); the auth cookie is shared with its subdomains
NEXT_PUBLIC_ROOT_DOMAIN=maavadao.com

# The member space (maava-dashboard), where members with a workspace are sent
NEXT_PUBLIC_MEMBER_SPACE_URL=https://agent.maavadao.com

# Optional: maava Configuration API URL for agent management dashboard
# NEXT_PUBLIC_CONFIG_API_URL=http://localhost:3000/api/v1

# Optional: maava gateway URL used by the frontend chat & dashboard at build time
# NEXT_PUBLIC_GATEWAY_URL=

# ── Server-side secrets (set via Secret Manager in production) ──

# JWT secret — MUST match the auth service JWT_SECRET
JWT_SECRET=change-this-in-production

# Cloud SQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/maavadao

# Cloud Run Deployer URL (the maava-deployer microservice)
DEPLOYER_URL=http://localhost:3009/api/v1

# Shared secret between frontend and maava-deployer
DEPLOYER_API_SECRET=change-this-deployer-secret

# Container image used for new tenant Cloud Run services
CLOUD_BACKEND_IMAGE=ghcr.io/maavadao/maava-gateway:latest

# GCS bucket that holds per-tenant agent state (mounted at /home/node/.openclaw)
GCS_BUCKET=maava-data

# LLM API key — Moonshot is the default provider
# Default model: moonshot/kimi-k2.5
MOONSHOT_API_KEY=sk-...

# ── Cloud mode ──
# Set to true to enable multi-tenant subdomain routing
NEXT_PUBLIC_CLOUD_MODE=false

# Optional: Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional: Sentry
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx
