# Moltbook Web Environment Variables

# ── Backend API URL ──
# For local development, use: http://localhost:3000
# For production, use your deployed API URL
NEXT_PUBLIC_API_URL=http://localhost:3000

# Auth microservice base URL (baked into the build by Next.js - MUST be set at docker build time)
# For local dev: http://localhost:8080
# For production: https://auth.mawadao.com
NEXT_PUBLIC_AUTH_URL=http://localhost:8080

# Root domain for subdomain routing (e.g. mawadao.com)
# When set, <subdomain>.mawadao.com routes to the tenant's backend.
NEXT_PUBLIC_ROOT_DOMAIN=mawadao.com

# Optional: OpenClaw Configuration API URL for agent management dashboard
# NEXT_PUBLIC_CONFIG_API_URL=http://localhost:3000/api/v1

# Optional: OpenClaw gateway URL used by the frontend chat & dashboard at build time
# NEXT_PUBLIC_OPENCLAW_GATEWAY_URL=

# ── Server-side secrets (set via Secret Manager in production) ──

# JWT secret — MUST match the auth service JWT_SECRET
JWT_SECRET=change-this-in-production

# Cloud SQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/mawadao

# Cloud Run Deployer URL (the cloud-run-deployer microservice)
CLOUD_RUN_DEPLOYER_URL=http://localhost:3009/api/v1

# Shared secret between frontend and cloud-run-deployer
DEPLOYER_API_SECRET=change-this-deployer-secret

# Container image used for new tenant Cloud Run services
CLOUD_BACKEND_IMAGE=ghcr.io/mawadao/mawadao-agent-gateway:latest

# GCS bucket that holds per-tenant agent state (mounted at /home/node/.openclaw)
GCS_BUCKET=mawadao-agent-data

# LLM API key — Moonshot is the default provider
# Default model: moonshot/kimi-k2.5
MOONSHOT_API_KEY=sk-...

# ── Cloud mode ──
# Set to true to enable multi-tenant subdomain routing
NEXT_PUBLIC_CLOUD_MODE=false

# Optional: Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional: Sentry
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx
